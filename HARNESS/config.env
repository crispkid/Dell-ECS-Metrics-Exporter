# Project-owned harness configuration for Dell ECS Metrics Exporter.
# This trusted Bash fragment must not contain secrets or private endpoints.

: "${HARNESS_PROJECT_NAME:=Dell ECS Metrics Exporter}"
: "${HARNESS_REQUIRED_PATHS:=AGENTS.md:PROJECT.md:SPECIFICATION.md:DELL_ECS_API_MAPPING.md:SPEC_CHANGELOG.md:DEVELOPMENT_PLAN.md:TEST_PLAN.md:TRACEABILITY.md}"
: "${HARNESS_EXPECTED_BASELINE_VERSION:=1.1.0}"

# ECS-012 closes the repository-owned V1 work for a prerelease without
# weakening the exact-build, deployed and reviewer requirements for stable
# production tags.
: "${HARNESS_REQUIRED_STAGES:=lint,format,typecheck,test,coverage,build,security,deploy,ci-policy}"
: "${HARNESS_FAIL_ON_SKIP:=false}"

: "${HARNESS_GOVERNANCE_MODE:=required}"
: "${HARNESS_REQUIRE_PLAN_APPROVAL:=false}"
: "${HARNESS_ACTIVE_CHANGE_ID:=ECS-012}"
: "${HARNESS_ACTIVE_CHANGE_FILE:=HARNESS/ACTIVE_CHANGE}"
: "${HARNESS_CHANGE_ID_PATTERN:=[A-Z][A-Z0-9_-]*-[0-9]+}"
: "${HARNESS_ALLOW_LEGACY_CHANGE_DISCOVERY:=false}"
: "${HARNESS_ALLOW_LEGACY_APPROVAL_FORMAT:=false}"
: "${HARNESS_SPEC_FILE:=SPECIFICATION.md}"
: "${HARNESS_CHANGELOG_FILE:=SPEC_CHANGELOG.md}"
: "${HARNESS_PLAN_FILE:=DEVELOPMENT_PLAN.md}"
: "${HARNESS_TEST_PLAN_FILE:=TEST_PLAN.md}"
: "${HARNESS_TRACE_FILE:=TRACEABILITY.md}"

: "${HARNESS_COVERAGE_THRESHOLD:=80}"
: "${HARNESS_STRICT_REPO_HYGIENE:=false}"

: "${HARNESS_REQUIRED_TOOLS:=git,go,helm,rg}"
: "${HARNESS_ENVIRONMENT_COMMAND:=./scripts/check-toolchain.sh}"
: "${HARNESS_COMMAND_TIMEOUT_SECONDS:=0}"
: "${HARNESS_WRITE_REPORTS:=true}"
: "${HARNESS_REPORT_DIR:=test-results/harness}"
: "${HARNESS_REPORT_FILE:=}"

: "${HARNESS_NETWORK_POLICY:=declared}"
: "${HARNESS_NETWORK_STAGES:=integration,e2e,security,deploy,ci-policy,supply-chain,agent-regression,agent-capability}"

: "${HARNESS_LINT_COMMAND:=./scripts/lint.sh}"
: "${HARNESS_FORMAT_COMMAND:=./scripts/format-check.sh}"
: "${HARNESS_TYPECHECK_COMMAND:=./scripts/typecheck.sh}"
: "${HARNESS_TEST_COMMAND:=./scripts/test.sh}"
: "${HARNESS_COVERAGE_COMMAND:=./scripts/coverage.sh}"
: "${HARNESS_BUILD_COMMAND:=./scripts/build.sh}"
: "${HARNESS_INTEGRATION_COMMAND:=./scripts/live-certification.sh}"
: "${HARNESS_E2E_COMMAND:=./scripts/e2e-check.sh}"
: "${HARNESS_SECURITY_COMMAND:=./scripts/security-check.sh}"
: "${HARNESS_DEPLOY_COMMAND:=./scripts/deploy-check.sh}"
: "${HARNESS_CI_POLICY_COMMAND:=./scripts/ci-policy-check.sh}"
: "${HARNESS_SUPPLY_CHAIN_COMMAND:=./scripts/supply-chain-check.sh}"

: "${HARNESS_AGENT_EVAL_DIR:=HARNESS/evals}"
: "${HARNESS_AGENT_TRIALS:=3}"
: "${HARNESS_AGENT_REGRESSION_COMMAND:=}"
: "${HARNESS_AGENT_CAPABILITY_COMMAND:=}"
