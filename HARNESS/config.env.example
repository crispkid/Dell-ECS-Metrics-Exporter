# Copy this file to HARNESS/config.env when project-specific overrides are needed.
# This is a committed, trusted Bash fragment sourced by harness.sh.
# Never put passwords, tokens, private keys, production endpoints, or personal
# data here. Supply secrets through the runtime/CI secret mechanism.
# The := form preserves values supplied by CI or the caller's environment.

: "${HARNESS_PROJECT_NAME:=}"
: "${HARNESS_REQUIRED_PATHS:=AGENTS.md:PROJECT.md}"
: "${HARNESS_EXPECTED_BASELINE_VERSION:=1.1.0}"

# Comma-separated internal stage names:
# lint,format,typecheck,test,coverage,build,integration,e2e,ci-policy,
# supply-chain,security,deploy
# Use "none" only for an intentional no-gate project documented in PROJECT.md.
# Adjust this list to the project's real Definition of Done before enabling CI.
: "${HARNESS_REQUIRED_STAGES:=lint,test,build}"
: "${HARNESS_FAIL_ON_SKIP:=false}"

# Governance: auto | required | off
: "${HARNESS_GOVERNANCE_MODE:=auto}"
: "${HARNESS_REQUIRE_PLAN_APPROVAL:=false}"
: "${HARNESS_ACTIVE_CHANGE_ID:=}"
: "${HARNESS_ACTIVE_CHANGE_FILE:=HARNESS/ACTIVE_CHANGE}"
: "${HARNESS_CHANGE_ID_PATTERN:=[A-Z][A-Z0-9_-]*-[0-9]+}"
: "${HARNESS_ALLOW_LEGACY_CHANGE_DISCOVERY:=false}"
: "${HARNESS_ALLOW_LEGACY_APPROVAL_FORMAT:=false}"
: "${HARNESS_SPEC_FILE:=SPECIFICATION.md}"
: "${HARNESS_CHANGELOG_FILE:=SPEC_CHANGELOG.md}"
: "${HARNESS_PLAN_FILE:=DEVELOPMENT_PLAN.md}"
: "${HARNESS_TEST_PLAN_FILE:=TEST_PLAN.md}"
: "${HARNESS_TRACE_FILE:=TRACEABILITY.md}"

: "${HARNESS_COVERAGE_THRESHOLD:=80}"
: "${HARNESS_STRICT_REPO_HYGIENE:=false}"

# Execution environment and evidence. Required tools are command names, not
# packages. A non-zero timeout requires GNU timeout or gtimeout on PATH.
: "${HARNESS_REQUIRED_TOOLS:=}"
: "${HARNESS_ENVIRONMENT_COMMAND:=}"
: "${HARNESS_COMMAND_TIMEOUT_SECONDS:=0}"
: "${HARNESS_WRITE_REPORTS:=true}"
: "${HARNESS_REPORT_DIR:=test-results/harness}"
: "${HARNESS_REPORT_FILE:=}"

# Network policy: deny | declared | allow. This exports
# HARNESS_NETWORK_ALLOWED to project commands and blocks stages explicitly
# declared network-dependent when policy is deny. It is not an OS sandbox.
: "${HARNESS_NETWORK_POLICY:=declared}"
: "${HARNESS_NETWORK_STAGES:=integration,e2e,security,deploy,ci-policy,supply-chain,agent-regression,agent-capability}"

# Leave blank for automatic detection. Use "skip" for an intentional opt-out.
: "${HARNESS_LINT_COMMAND:=}"
: "${HARNESS_FORMAT_COMMAND:=}"
: "${HARNESS_TYPECHECK_COMMAND:=}"
: "${HARNESS_TEST_COMMAND:=}"
: "${HARNESS_COVERAGE_COMMAND:=}"
: "${HARNESS_BUILD_COMMAND:=}"
: "${HARNESS_INTEGRATION_COMMAND:=}"
: "${HARNESS_E2E_COMMAND:=}"
: "${HARNESS_SECURITY_COMMAND:=}"
: "${HARNESS_DEPLOY_COMMAND:=}"
: "${HARNESS_CI_POLICY_COMMAND:=}"
: "${HARNESS_SUPPLY_CHAIN_COMMAND:=}"

# Agent behavior evaluation is separate from project verification. The runner
# owns trial orchestration and writes redacted transcripts/outcomes to the
# project-designated report directory.
: "${HARNESS_AGENT_EVAL_DIR:=HARNESS/evals}"
: "${HARNESS_AGENT_TRIALS:=3}"
: "${HARNESS_AGENT_REGRESSION_COMMAND:=}"
: "${HARNESS_AGENT_CAPABILITY_COMMAND:=}"
