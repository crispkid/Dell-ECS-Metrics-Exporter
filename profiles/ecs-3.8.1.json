    {
      "id": "DELL-KB-000205031-PERSISTED",
      "effect": "Accepted server names configured before upgrade can remain active on ECS 3.8.1.",
      "mitigation": "Keep hostname, TLS SNI and Host consistent even though fresh 3.8.1 deployments may accept all hosts by default."
    },
    {
      "id": "ECS381-REST-REFERENCE-PENDING",
      "effect": "The official REST API ZIP is listed by Dell but requires an authenticated support session and has not been reviewed in this repository.",
      "mitigation": "Treat management mappings inherited from 3.6 as candidates and block sandbox certification until the 3.8.1 ZIP and live responses are compared."
    },
    {
      "id": "ECSCE3814-FLUX-503-OBSERVED",
      "effect": "The isolated ECS CE 3.8.1.4 build returned HTTP 503 for the Flux external query endpoint while Management-backed collectors succeeded.",
      "mitigation": "Preserve Management inventory and report DEGRADED for node-resources; do not infer production appliance Flux support from the CE result."
    }
  ],
