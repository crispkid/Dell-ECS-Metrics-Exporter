*.pem
*.crt
*.cer
*.der
*.csr
*.key
*.p12
*.pfx
*.jks
*.kdb
*.keystore
*.mobileprovision
*.ovpn
*.agekey
age.key
age-identity.txt
**/.gnupg/
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_ecdsa
id_ecdsa.*
**/.ssh/
**/known_hosts.local

# Local Go workspace and caches
/go.work
/go.work.sum
/.cache/
/.gocache/
/.gomodcache/
/.scanner-cache/
/.osv-scanner/

# Editor and IDE state
/.idea/
/.vscode/
/.fleet/
/.zed/
/.history/
*.swp
*.swo
*~

# Operating-system metadata
.DS_Store
._*
Thumbs.db
Desktop.ini

# Helm packaging output
/charts/*.tgz
/charts/**/*.tgz

# Local container, Kubernetes, cloud, and infrastructure state
**/docker-compose.override.yml
**/docker-compose.override.yaml
**/compose.override.yml
**/compose.override.yaml
**/.docker/
**/.kube/
**/kubeconfig
**/kubeconfig.*
*.kubeconfig
!**/kubeconfig.example
**/.aws/
**/.azure/
**/.config/gcloud/
**/.config/gh/hosts.yml
*.tfstate
*.tfstate.*
**/.terraform/
/.govc.env
/.govc/
govc*.env

# HTTP sessions, browser exports, and network captures
*.har
*.pcap
*.pcapng
cookies.txt
cookies-*.txt

