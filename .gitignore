# Keep credentials, production data, local infrastructure state, and generated
# output out of Git. These rules do not remove files that are already tracked;
# run the repository security check before every push.

# Local-only Codex, specification, governance, and validation references
/AGENTS.md
/CODE_REVIEW.md
/CONTRIBUTING.md
/DELL_ECS_API_MAPPING.md
/DEVELOPMENT_PLAN.md
/GITHUB_ACTIONS.md
/PLANS.md
/PROJECT.md
/SPECIFICATION.md
/SPEC_CHANGELOG.md
/TEST_PLAN.md
/TRACEABILITY.md
/HARNESS/
/plans/
/docs/RC_RELEASE_CHECKLIST.md
/docs/RELEASE_CHECKLIST.md
/docs/ecs-api/
/.agents/
/.codex/

# Build, coverage, profiling, and test output
/bin/
/coverage/
/dist/
/test-results/
/artifacts/
/reports/
/evidence/
/ecs-flux-probe*.json
/.tmp/
/tmp/
*.test
*.out
*.prof
*.pprof
*.coverprofile
coverage.out
*.log
*.pid
*.sock
core
core.*
*.core
*.dump

# Local runtime configuration and overrides
/config.yaml
/config.*.yaml
!/config.example.yaml
/values*.yaml
!/values.example.yaml
*.local.yaml
*.local.yml
*.override.yaml
*.override.yml

# Environment files, credentials, and secret directories
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
**/.envrc
**/.direnv/
/.local/
**/.local-secrets/
**/.secrets/
**/secrets/
**/certs/
**/credentials.json
**/client_secret.json
**/service-account.json
**/service_account.json
**/application_default_credentials.json
**/.netrc
**/.npmrc
**/.pypirc

